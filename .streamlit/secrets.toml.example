# Template pour Streamlit Cloud
# Dans Streamlit Cloud : Settings → Secrets → coller le contenu ci-dessous avec vos vraies clés
# En local : copier en .streamlit/secrets.toml (ce fichier est dans .gitignore)

OPENAI_API_KEY = "sk-..."
LANGFUSE_PUBLIC_KEY = "pk-lf-..."
LANGFUSE_SECRET_KEY = "sk-lf-..."
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"
